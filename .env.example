# Copy this file to .env and fill in the values.
# The app reads these at startup — restart the server after changes.

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) SSO  — recommended
# ---------------------------------------------------------------------------
# 1. Go to https://portal.azure.com → Azure Active Directory → App registrations
# 2. Click "New registration", give it a name (e.g. "Help Desk Status")
# 3. Under "Redirect URI" add:  http://localhost:3000/auth/callback
#    (replace the hostname/port for production)
# 4. After registration, copy the Application (client) ID → OIDC_CLIENT_ID
# 5. Copy the Directory (tenant) ID → replace {tenant} in OIDC_ISSUER below
# 6. Go to "Certificates & secrets" → "New client secret" → copy the value → OIDC_CLIENT_SECRET

OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
OIDC_CLIENT_ID=your-application-client-id
OIDC_CLIENT_SECRET=your-client-secret-value

# The redirect URI must exactly match what you registered in Entra.
# Defaults to http://localhost:3000/auth/callback if not set.
#OIDC_REDIRECT_URI=https://your-domain.example.com/auth/callback

# ---------------------------------------------------------------------------
# Session security
# ---------------------------------------------------------------------------
# Generate a strong random value, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, sessions are lost on every restart.
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Basic Auth fallback (only used when OIDC is NOT configured)
# ---------------------------------------------------------------------------
# If you leave OIDC unconfigured the app falls back to HTTP Basic Auth.
# Set a strong password here; otherwise a random one is printed to the console
# on each startup.
#ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Other settings
# ---------------------------------------------------------------------------
#PORT=3000
#STATE_FILE=/path/to/state.json
#NODE_ENV=production
